{
  "$schema": "https://raw.githubusercontent.com/bagasadh/termcard/main/termcard.schema.json",
  "theme": "dashed-dark",
  "width": 560,
  "radius": 6,
  "cards": [
    {
      "type": "typing",
      "output": "typing.svg",
      "prompt_top": "┌ your-username",
      "prompt_bottom": "└›",
      "words": ["Hi", "fastfetch"],
      "duration": 8
    },
    {
      "type": "info",
      "output": "info.svg",
      "sections": [
        [
          ["Host", "Your Name"],
          ["Role", "Software Developer"]
        ],
        [
          ["OS", "Linux x86_64"],
          ["Editor", "Neovim"],
          ["Shell", "zsh"]
        ]
      ]
    },
    {
      "type": "streak",
      "output": "streak.svg",
      "user": "your-username",
      "timezone_offset": 7,
      "title": "Streak",
      "current_label": "Current streak",
      "longest_label": "Longest streak"
    },
    {
      "type": "link",
      "output": "contact-email.svg",
      "label": "Email",
      "value": "you@example.com",
      "url": "mailto:you@example.com"
    }
  ]
}
